# Fastfile for TidyTV — Google Play (same lanes as flofocus/essence, but the build is Gradle).
# Run with: bundle exec fastlane android <lane>
#
#   bundle exec fastlane android deploy_internal            build the AAB and upload it to the internal track
#   CONFIRM=1 bundle exec fastlane android promote_to_production
#   CONFIRM=1 bundle exec fastlane android deploy_production   build the AAB and upload it straight to production
#   bundle exec fastlane android verify                     read back which version codes each track has
#   bundle exec fastlane android metadata_download          pull the live listing (read-only)
#   bundle exec fastlane android metadata_upload validate_only:true
#   bundle exec fastlane android upload_screenshots
#
# SKIP_BUILD=1 reuses the AAB already in app/build. Changelogs: fastlane/metadata/android/<locale>/changelogs/<versionCode>.txt

default_platform(:android)

project_root = File.expand_path("..", __dir__)
aab_path = File.join(project_root, "app/build/outputs/bundle/release/app-release.aab")
metadata_path = "./fastlane/metadata/android"

# Production is a public release step: it runs only with CONFIRM=1 (and winkle-guard asks Joe).
def confirm!(what)
  return if ENV["CONFIRM"] == "1"
  UI.user_error!("#{what} is a public release step. Re-run with CONFIRM=1 to go ahead.")
end

def build_aab
  Bundler.with_unbundled_env { sh("cd .. && ./gradlew -q :app:bundleRelease") }
end

platform :android do
  desc "Download the live Play listing into fastlane/metadata/android/ (read-only)"
  lane :metadata_download do
    download_from_play_store(track: "production", metadata_path: metadata_path)
    UI.success "Metadata downloaded to #{metadata_path}/"
  end

  desc "Upload listing text (and changelogs with version_code:N). validate_only:true checks without changing anything"
  lane :metadata_upload do |options|
    version_code = options[:version_code] ? options[:version_code].to_i : nil
    supply(
      track: "production",
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: version_code.nil?,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options[:validate_only].to_s == "true",
      version_code: version_code,
    )
    UI.success(options[:validate_only].to_s == "true" ? "Metadata validated" : "Metadata pushed to Play")
  end

  desc "Upload screenshots and images only (no AAB, no listing text)"
  lane :upload_screenshots do |options|
    supply(
      track: "production",
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      sync_image_upload: true,
      validate_only: options[:validate_only].to_s == "true",
      version_code: options[:version_code] ? options[:version_code].to_i : nil,
    )
    UI.success "Screenshots uploaded to Play"
  end

  desc "Build the AAB and upload it to the internal testing track"
  lane :deploy_internal do
    build_aab unless ENV["SKIP_BUILD"] == "1"
    supply(
      track: "internal",
      aab: aab_path,
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
    )
    UI.success "AAB uploaded to the internal track"
  end

  desc "Build the AAB and upload it to the production track for review (CONFIRM=1)"
  lane :deploy_production do
    confirm!("Uploading to the Play production track")
    build_aab unless ENV["SKIP_BUILD"] == "1"
    supply(
      track: "production",
      aab: aab_path,
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
    )
    UI.success "Production upload complete — check Play Console"
  end

  desc "Promote the internal build to production (CONFIRM=1)"
  lane :promote_to_production do
    confirm!("Promoting to Play production")
    supply(
      track: "internal",
      track_promote_to: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success "Build promoted to production"
  end

  desc "Read back which version codes the internal and production tracks have"
  lane :verify do
    %w[internal production].each do |track|
      UI.message("Play #{track}: #{google_play_track_version_codes(track: track).inspect}")
    end
  end
end
